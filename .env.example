# ───────────────────────────────────────────────────────────────────────────────
# KiriDev — configuración. Con Docker no hace falta tocar nada: ./install.sh crea .env solo.
# Copiá este archivo a .env solo si preferís configurarlo a mano:  cp .env.example .env
# ───────────────────────────────────────────────────────────────────────────────

# ── Panel (obligatorio) ──
ADMIN_USER=admin
ADMIN_PASSWORD=cambiame-por-una-clave-larga
JWT_SECRET=            # openssl rand -hex 32
HUB_PORT=4961

# ── Secretos internos entre servicios (obligatorios, aleatorios) ──
AGENT_TOKEN=           # openssl rand -hex 24  (n8n → hub)
EVOLUTION_API_KEY=     # openssl rand -hex 24  (hub/n8n → Evolution API)
POSTGRES_PASSWORD=     # openssl rand -hex 16  (base de datos de Evolution)
N8N_ENCRYPTION_KEY=    # openssl rand -hex 16

# ── WhatsApp (Evolution API) ──
EVOLUTION_INSTANCE=kiridev      # nombre de la instancia del número principal

# ── Motor de IA (elegí UNO; también se puede hacer desde el panel → «Cuentas y motores») ──
# Opción 1: suscripción de Claude. Ejecutá «claude setup-token» en tu PC y pegá el token.
CLAUDE_CODE_OAUTH_TOKEN=
# Opción 2: clave de API de Anthropic.
ANTHROPIC_API_KEY=
# Opción 3: OpenCode con modelos gratuitos → no requiere nada aquí; se conecta desde el panel.

# ── Opcionales ──
GROQ_API_KEY=                   # transcribir notas de voz (Whisper en Groq, tiene capa gratuita)
ELEVENLABS_API_KEY=             # que el agente responda con notas de voz (sin esto usa voces gratis de Edge)
HUB_BASE_URL=                   # URL pública https del panel (para enlaces de login de MCP y paneles personales)
TIMEZONE=America/Asuncion       # zona horaria de recordatorios y tareas programadas
AGENT_ROOT=0                    # 1 = el agente puede usar sudo DENTRO de su contenedor (instalar paquetes)

# ── Solo si NO usás Docker Compose (ejecución manual con npm) ──
# PORT=4961
# DATA_DIR=./data
# EVOLUTION_URL=http://localhost:8080
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/kiri-whatsapp
# CLAUDE_BIN=claude

# ── Docker aislado del agente + apps con URL (muy opcional; ver README → «Funciones opcionales») ──
# DOCKER_HOST=
# DOCKER_TLS_VERIFY=1
# DOCKER_CERT_PATH=/data/docker-certs
# APPS_HOST_SUFFIX=             # ej. .apps.tudominio.com
